<Window
    x:Class="TokdashCompanion.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tokdash"
    Width="384"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStyle="None"
    ShowInTaskbar="False"
    Topmost="True"
    ShowActivated="True"
    Background="Transparent"
    AllowsTransparency="True"
    Deactivated="FlyoutWindow_Deactivated"
    KeyDown="FlyoutWindow_KeyDown">
    <Window.Resources>
        <!-- Theme brushes are swapped in code-behind (light / dark / high-contrast). -->
        <SolidColorBrush x:Key="FlyoutBg" Color="#F2F4F7" Opacity="0.92"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#5F5F5F"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#767676"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#000000" Opacity="0.08"/>
        <SolidColorBrush x:Key="BtnBg" Color="#FFFFFF" Opacity="0.70"/>
        <SolidColorBrush x:Key="BtnBorder" Color="#000000" Opacity="0.14"/>
        <SolidColorBrush x:Key="BtnText" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="PrimaryBg" Color="#0067C0"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="IconBtnHover" Color="#000000" Opacity="0.06"/>
        <SolidColorBrush x:Key="SegBg" Color="#000000" Opacity="0.06"/>
        <SolidColorBrush x:Key="SegIdleBg" Color="Transparent"/>
        <SolidColorBrush x:Key="SegSelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SegSelText" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="SegText" Color="#5F5F5F"/>
        <SolidColorBrush x:Key="FooterBg" Color="#000000" Opacity="0.03"/>
        <SolidColorBrush x:Key="FooterBorder" Color="#000000" Opacity="0.06"/>
        <SolidColorBrush x:Key="BarTrack" Color="#000000" Opacity="0.10"/>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- Standard push button (4px radius, hairline border). -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BtnText}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,5,14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource BtnBorder}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource IconBtnHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary (accent) button. -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Header icon button (transparent, hover highlight). -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource IconBtnHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented (Low/All) pill button. -->
        <Style x:Key="SegBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SegText}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,2,10,3"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="8" BorderThickness="1"
            BorderBrush="{DynamicResource DividerBrush}">
        <Border.Background>
            <SolidColorBrush x:Name="RootBg" Color="#F2F4F7" Opacity="0.92"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.30" BlurRadius="28" ShadowDepth="8" Direction="270"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid Margin="16,12,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Width="15" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Canvas Width="371" Height="394">
                        <Rectangle Width="323" Height="296" Canvas.Left="24" Canvas.Top="24" RadiusX="56" RadiusY="56" Fill="White" Stroke="#08253F" StrokeThickness="26"/>
                        <Path Data="M146,312 L146,380 L226,312 Z" Fill="#08253F"/>
                        <Rectangle Width="46" Height="70" Canvas.Left="90" Canvas.Top="228" RadiusX="7" RadiusY="7" Fill="#437C76"/>
                        <Rectangle Width="46" Height="106" Canvas.Left="170" Canvas.Top="192" RadiusX="7" RadiusY="7" Fill="#437C76"/>
                        <Rectangle Width="46" Height="156" Canvas.Left="250" Canvas.Top="142" RadiusX="7" RadiusY="7" Fill="#437C76"/>
                        <Path Data="M98,240 L160,158 L216,184 L294,84" Stroke="#B9967D" StrokeThickness="13" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <Ellipse Width="40" Height="40" Canvas.Left="78" Canvas.Top="220" Fill="#B9967D"/>
                        <Ellipse Width="40" Height="40" Canvas.Left="140" Canvas.Top="138" Fill="#B9967D"/>
                        <Ellipse Width="40" Height="40" Canvas.Left="196" Canvas.Top="164" Fill="#B9967D"/>
                        <Ellipse Width="40" Height="40" Canvas.Left="274" Canvas.Top="64" Fill="#B9967D"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="Tokdash" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Style="{StaticResource BodyText}"/>
                <Ellipse Grid.Column="2" Width="7" Height="7" Margin="8,0,5,0" VerticalAlignment="Center" x:Name="ConnDot" Fill="#30A74C"/>
                <TextBlock Grid.Column="3" x:Name="ConnText" Text="Connecting…" FontSize="12" VerticalAlignment="Center" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}"/>
                <Button Grid.Column="4" x:Name="RefreshBtn" Click="Refresh_Click" Style="{StaticResource IconBtn}" ToolTip="Refresh" Content="&#xE72C;" Margin="4,0,0,0"/>
                <Button Grid.Column="5" x:Name="GearBtn" Click="Gear_Click" Style="{StaticResource IconBtn}" ToolTip="Settings" Content="&#xE713;" Margin="2,0,0,0"/>
            </Grid>
            <Separator x:Name="Sep1" Opacity="0.4"/>

            <!-- Banner (offline/busy/wrong-service) -->
            <StackPanel x:Name="Banner" Margin="16,10" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock x:Name="BannerIcon" Text="⚠" FontSize="14" Foreground="#FF453A" Margin="0,0,9,0" VerticalAlignment="Top"/>
                <StackPanel>
                    <TextBlock x:Name="BannerTitle" Text="" FontWeight="SemiBold" FontSize="13" Style="{StaticResource BodyText}"/>
                    <TextBlock x:Name="BannerBody" Text="" FontSize="12" TextWrapping="Wrap" MaxWidth="300" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BannerRetry" Content="Retry" Click="Refresh_Click" Style="{StaticResource WinBtn}" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <Button x:Name="BannerSettings" Content="Settings" Click="Gear_Click" Style="{StaticResource WinBtn}" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <Separator x:Name="SepBanner" Opacity="0.4" Visibility="Collapsed"/>

            <!-- Today hero -->
            <StackPanel Margin="16,12" x:Name="HeroPanel">
                <TextBlock Text="TODAY" FontSize="11" FontWeight="SemiBold" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="TodayCost" Text="…" FontSize="28" FontWeight="SemiBold" Style="{StaticResource BodyText}"/>
                <TextBlock x:Name="TodaySub" Text="" FontSize="12.5" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="TodayCmp" Text="" FontSize="12.5" Foreground="#0F7B0F" Style="{StaticResource BodyText}"/>
            </StackPanel>
            <Separator Opacity="0.4"/>

            <!-- Month context -->
            <StackPanel Margin="16,10" Orientation="Horizontal">
                <TextBlock x:Name="MonthLabel" Text="" FontSize="11" FontWeight="SemiBold" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="MonthCost" Text="" FontSize="12.5" FontWeight="SemiBold" Margin="10,0,0,0" Style="{StaticResource BodyText}"/>
                <TextBlock x:Name="MonthTokens" Text="" FontSize="12.5" Margin="10,0,0,0" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
            <Separator Opacity="0.4"/>

            <!-- Quota section -->
            <StackPanel Margin="16,12" x:Name="QuotaPanel">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="QuotaHeader" Text="SUBSCRIPTION" FontSize="11" FontWeight="SemiBold" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}"/>
                    <Border Grid.Column="1" CornerRadius="4" Padding="1" Background="{DynamicResource SegBg}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LowBtn" Click="Low_Click" Content="Low" Style="{StaticResource SegBtn}"/>
                            <Button x:Name="AllBtn" Click="All_Click" Content="All" Style="{StaticResource SegBtn}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel x:Name="QuotaRows"/>
            </StackPanel>
            <Separator Opacity="0.4"/>

            <!-- Activity line -->
            <TextBlock x:Name="ActivityText" Margin="16,10" FontSize="12" Visibility="Collapsed" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}"/>
            <Separator x:Name="SepActivity" Opacity="0.4" Visibility="Collapsed"/>

            <!-- Action row -->
            <StackPanel Margin="16,10" Orientation="Horizontal">
                <Button Click="OpenDashboard_Click" Content="Open Dashboard" Padding="14,5,14,6" Style="{StaticResource PrimaryBtn}"/>
            </StackPanel>

            <!-- Footer band -->
            <Border Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource FooterBorder}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="FreshnessText" FontSize="11" Style="{StaticResource BodyText}" Foreground="{DynamicResource FaintBrush}"/>
                    <TextBlock Grid.Column="1" Text="Right-click tray icon for more" FontSize="11" Style="{StaticResource BodyText}" Foreground="{DynamicResource FaintBrush}"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
