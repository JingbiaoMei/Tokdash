<Window
    x:Class="TokdashCompanion.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Activated="FlyoutWindow_Activated">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,10,16,10" x:Name="HeaderRow">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Tokdash" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
            <Ellipse Grid.Column="1" Width="7" Height="7" Margin="8,0,5,0" VerticalAlignment="Center" x:Name="ConnDot"/>
            <TextBlock Grid.Column="2" Text="{x:Bind Store.ConnectionLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="3" x:Name="GearBtn" Click="Gear_Click" Background="Transparent" BorderThickness="0" Padding="6" ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="13"/>
            </Button>
        </Grid>

        <!-- Banner (offline/busy) -->
        <Border Grid.Row="1" Padding="16,10,16,10" x:Name="Banner" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="9">
                <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="#FF453A" x:Name="BannerIcon"/>
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Store.BannerTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="{x:Bind Store.BannerBody, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Today hero -->
        <StackPanel Grid.Row="2" Padding="16,12,16,12" Spacing="2" x:Name="HeroPanel">
            <TextBlock Text="TODAY" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="TodayCost" Text="{x:Bind Store.Snapshot.TodayCostText, Mode=OneWay}" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock x:Name="TodaySub" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="TodayCmp" FontSize="12.5" Foreground="#248A3D"/>
        </StackPanel>

        <!-- Month context -->
        <StackPanel Grid.Row="3" Padding="16,10,16,10" Orientation="Horizontal" Spacing="10" x:Name="MonthPanel">
            <TextBlock x:Name="MonthLabel" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="MonthCost" FontWeight="SemiBold" FontSize="12.5"/>
            <TextBlock x:Name="MonthTokens" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Quota section -->
        <StackPanel Grid.Row="4" Padding="16,12,16,12" Spacing="8" x:Name="QuotaPanel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="QuotaHeader" Text="SUBSCRIPTION" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ToggleSwitch Grid.Column="1" x:Name="QuotaToggle" OffContent="Low" OnContent="All" Toggled="QuotaToggle_Toggled" MinWidth="92"/>
            </Grid>
            <StackPanel x:Name="QuotaRows" Spacing="10"/>
        </StackPanel>

        <!-- Activity line -->
        <Border Grid.Row="5" Padding="16,10,16,10" x:Name="ActivityBorder" Visibility="Collapsed">
            <TextBlock x:Name="ActivityText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Border>

        <!-- Action row -->
        <StackPanel Grid.Row="6" Padding="16,10,16,10" Orientation="Horizontal" Spacing="8">
            <Button Click="OpenDashboard_Click" x:Name="OpenBtn">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
                    <TextBlock Text="Open Dashboard"/>
                </StackPanel>
            </Button>
            <Button Click="Refresh_Click" x:Name="RefreshBtn" ToolTipService.ToolTip="Refresh" Padding="10,6,10,6">
                <FontIcon Glyph="&#xE72C;" FontSize="13"/>
            </Button>
        </StackPanel>

        <!-- Freshness footer -->
        <Grid Grid.Row="7" Padding="16,8,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="FreshnessText" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Grid>
    </Grid>
</Window>
