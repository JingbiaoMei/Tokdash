<Window
    x:Class="TokdashCompanion.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="Tokdash"
    Width="340"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStyle="None"
    ShowInTaskbar="False"
    Topmost="True"
    ShowActivated="True"
    Background="{DynamicResource WindowBg}"
    AllowsTransparency="False"
    UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    SnapsToDevicePixels="True"
    Deactivated="FlyoutWindow_Deactivated"
    KeyDown="FlyoutWindow_KeyDown">
    <Window.Resources>
        <!-- Theme brushes are swapped in code-behind (light / dark / high-contrast). -->
        <SolidColorBrush x:Key="FlyoutBg" Color="#F2F4F7" Opacity="0.92"/>
        <SolidColorBrush x:Key="WindowBg" Color="#F2F4F7"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#5F5F5F"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#767676"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#000000" Opacity="0.08"/>
        <SolidColorBrush x:Key="BtnBg" Color="#FFFFFF" Opacity="0.70"/>
        <SolidColorBrush x:Key="BtnBorder" Color="#000000" Opacity="0.14"/>
        <SolidColorBrush x:Key="BtnText" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="PrimaryBg" Color="#0067C0"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="IconBtnHover" Color="#000000" Opacity="0.06"/>
        <SolidColorBrush x:Key="SegBg" Color="#000000" Opacity="0.06"/>
        <SolidColorBrush x:Key="SegIdleBg" Color="Transparent"/>
        <SolidColorBrush x:Key="SegSelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SegSelText" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="SegText" Color="#5F5F5F"/>
        <SolidColorBrush x:Key="FooterBg" Color="#000000" Opacity="0.03"/>
        <SolidColorBrush x:Key="FooterBorder" Color="#000000" Opacity="0.06"/>
        <SolidColorBrush x:Key="BarTrack" Color="#000000" Opacity="0.10"/>

        <!-- Spacing scale: every section's horizontal inset is 16 so left edges align
             down the whole flyout. Thickness resources cover the recurring band shapes;
             one-off inner gaps are written as literals drawn from the same 4/8/12/16
             rhythm (Thickness has no TypeConverter from a bare double, so the GapX
             resources below can't be used for Margin/Padding directly - only for
             double-typed properties like FontSize). -->
        <Thickness x:Key="SectionPad">16,12,16,12</Thickness>
        <Thickness x:Key="BandPad">16,10,16,10</Thickness>
        <Thickness x:Key="FooterPad">16,8,16,8</Thickness>
        <sys:Double x:Key="GapXS">4</sys:Double>
        <sys:Double x:Key="GapS">8</sys:Double>
        <sys:Double x:Key="GapM">12</sys:Double>
        <sys:Double x:Key="GapL">16</sys:Double>

        <!-- Type scale. TextFormattingMode=Display snaps glyphs to whole pixels and
             rejects fractional sizes cleanly, so only these values are used anywhere. -->
        <sys:Double x:Key="FontHero">30</sys:Double>
        <sys:Double x:Key="FontHeroEmpty">15</sys:Double>
        <sys:Double x:Key="FontBody">13</sys:Double>
        <sys:Double x:Key="FontSecondary">12</sys:Double>
        <sys:Double x:Key="FontCaption">11</sys:Double>
        <sys:Double x:Key="FontMicro">10</sys:Double>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- Standard push button (4px radius, hairline border). -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BtnText}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
            <Setter Property="Padding" Value="14,5,14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource BtnBorder}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource IconBtnHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary (accent) button. -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Header icon button (transparent, hover highlight). -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource IconBtnHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented (Low/All) pill button. -->
        <Style x:Key="SegBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SegText}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="{StaticResource FontCaption}"/>
            <Setter Property="Padding" Value="10,2,10,3"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared row shape: label and percentage on the first line, then the quota bar
             and reset time below. The shared right column keeps percentage and reset text
             aligned without taking the long provider label's horizontal space. -->
        <DataTemplate x:Key="QuotaRowTemplate">
            <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MinWidth="84"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="{StaticResource FontSecondary}"
                               FontWeight="Medium" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Visibility="{Binding EstimatedVisibility}"
                            BorderBrush="{DynamicResource MutedBrush}" BorderThickness="0.5" CornerRadius="4"
                            Padding="4,0,4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EstimatedText}" FontSize="{StaticResource FontMicro}" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PercentText}" FontSize="{StaticResource FontSecondary}"
                           FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"/>

                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ResetsText}" FontSize="{StaticResource FontCaption}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}"/>

                <!-- Coloured quota bar: light track with a coloured fill sized to the % left.
                     Buckets without a remaining_percent hide the bar but keep their reset time. -->
                <Border Grid.Row="1" Grid.Column="0" Visibility="{Binding BarVisibility}"
                        CornerRadius="2" Background="{DynamicResource BarTrack}" Height="4" Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding FillStar}"/>
                            <ColumnDefinition Width="{Binding RestStar}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="2" Background="{Binding BarBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- All-view group: provider header, inline "last known" warning, then its rows via
             the same QuotaRowTemplate so Low and All render identically row-for-row. -->
        <DataTemplate x:Key="QuotaGroupTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Provider}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,4"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding WarningVisibility}" Margin="0,0,0,4">
                    <TextBlock Text="⚠" FontSize="{StaticResource FontSecondary}" Foreground="#FF9F0A"
                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding WarningText}" FontSize="{StaticResource FontCaption}"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource QuotaRowTemplate}"/>
                <!-- Reset-credits row: last inside its provider group, All view only.
                     Quiet text row, not a bar - it has no percentage. The mock's design:
                     2px amber left-accent bar, amber text (#FFB87A0D = macOS .72/.48/.05,
                     the same on both themes), and a muted right-aligned "use or lose" hint
                     on the same row. The hint is static decoration - never part of the
                     pinned CreditsNotice string. -->
                <Grid Visibility="{Binding CreditsVisibility}" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="2" CornerRadius="1" Background="#FFB87A0D" Margin="0,1,8,1"/>
                    <TextBlock Grid.Column="1" Text="{Binding CreditsText}" FontSize="{StaticResource FontCaption}"
                               Foreground="#FFB87A0D" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding CreditsUseOrLoseText}" FontSize="{StaticResource FontMicro}"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Top-rank pill: optional harness mark, display name, compact tokens. Model rows
             simply have no mark (never a placeholder). -->
        <DataTemplate x:Key="RankTemplate">
            <Border CornerRadius="4" Background="{DynamicResource SegIdleBg}" BorderBrush="{DynamicResource BtnBorder}"
                    BorderThickness="0.5" Padding="7,3,7,4" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Logo}" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"
                           Visibility="{Binding LogoVisibility}"/>
                    <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontCaption}"><Run Text="{Binding Label}" FontWeight="Medium" Foreground="{DynamicResource TextBrush}"/><Run Text="  "/><Run Text="{Binding Value}" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- CornerRadius matches DWMWCP_ROUND's 8px silhouette so the 1px border curves with
         the DWM clip instead of being cut off at the corners, and the footer band's own
         0,0,8,8 radius lines up with it. The corner triangles outside this radius are
         painted with the identical opaque WindowBg, so nothing shows through. -->
    <Border x:Name="RootBorder" CornerRadius="8" BorderThickness="1"
            BorderBrush="{DynamicResource DividerBrush}">
        <Border.Background>
            <SolidColorBrush x:Name="RootBg" Color="#F2F4F7"/>
        </Border.Background>
        <StackPanel>
            <!-- Header -->
            <Grid Margin="{StaticResource BandPad}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Width="15" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Canvas Width="371" Height="394">
                        <Rectangle Width="323" Height="296" Canvas.Left="24" Canvas.Top="24" RadiusX="56" RadiusY="56" Fill="White" Stroke="#08253F" StrokeThickness="26"/>
                        <Path Data="M146,312 L146,380 L226,312 Z" Fill="#08253F"/>
                        <Rectangle Width="46" Height="70" Canvas.Left="90" Canvas.Top="228" RadiusX="7" RadiusY="7" Fill="#437C76"/>
                        <Rectangle Width="46" Height="106" Canvas.Left="170" Canvas.Top="192" RadiusX="7" RadiusY="7" Fill="#437C76"/>
                        <Rectangle Width="46" Height="156" Canvas.Left="250" Canvas.Top="142" RadiusX="7" RadiusY="7" Fill="#437C76"/>
                        <Path Data="M98,240 L160,158 L216,184 L294,84" Stroke="#B9967D" StrokeThickness="13" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <Ellipse Width="40" Height="40" Canvas.Left="78" Canvas.Top="220" Fill="#B9967D"/>
                        <Ellipse Width="40" Height="40" Canvas.Left="140" Canvas.Top="138" Fill="#B9967D"/>
                        <Ellipse Width="40" Height="40" Canvas.Left="196" Canvas.Top="164" Fill="#B9967D"/>
                        <Ellipse Width="40" Height="40" Canvas.Left="274" Canvas.Top="64" Fill="#B9967D"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="Tokdash" FontWeight="SemiBold" FontSize="{StaticResource FontBody}" VerticalAlignment="Center" Style="{StaticResource BodyText}"/>
                <Ellipse Grid.Column="2" Width="7" Height="7" Margin="8,0,5,0" VerticalAlignment="Center" x:Name="ConnDot" Fill="#30A74C"/>
                <TextBlock Grid.Column="3" x:Name="ConnText" Text="Connecting…" FontSize="{StaticResource FontSecondary}" VerticalAlignment="Center" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}"/>
                <Button Grid.Column="4" x:Name="RefreshBtn" Click="Refresh_Click" Style="{StaticResource IconBtn}"
                        ToolTip="Refresh" AutomationProperties.Name="Refresh" Content="&#xE72C;" Margin="4,0,0,0"/>
                <!-- Gear + update badge. The dot is an overlay inside this Grid rather than
                     another header column, so it can appear and disappear without shifting
                     the gear or anything left of it. Static by design: it marks "there's
                     something in Settings", it isn't an alert, so it never animates. -->
                <Grid Grid.Column="5" Margin="2,0,0,0">
                    <Button x:Name="GearBtn" Click="Gear_Click" Style="{StaticResource IconBtn}"
                            ToolTip="Settings" AutomationProperties.Name="Settings" Content="&#xE713;"/>
                    <Ellipse x:Name="UpdateBadge" Width="6" Height="6" Fill="#FF453A"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,5,4,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
            <Border x:Name="Sep1" Height="1" Background="{DynamicResource DividerBrush}"/>

            <!-- Banner (offline/busy/wrong-service). A Grid (not a horizontal StackPanel) so
                 the text column is genuinely *-sized and TextWrapping works without a magic
                 MaxWidth - a StackPanel gives its children infinite width during measure. -->
            <Grid x:Name="Banner" Margin="{StaticResource BandPad}" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BannerIcon" Grid.Column="0" Text="⚠" FontSize="14" Foreground="#FF453A" Margin="0,0,9,0" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="BannerTitle" Text="" FontWeight="SemiBold" FontSize="{StaticResource FontBody}" Style="{StaticResource BodyText}"/>
                    <TextBlock x:Name="BannerBody" Text="" FontSize="{StaticResource FontSecondary}" TextWrapping="Wrap" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BannerRetry" Content="Retry" Click="Refresh_Click" Style="{StaticResource WinBtn}" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <Button x:Name="BannerSettings" Content="Settings" Click="Gear_Click" Style="{StaticResource WinBtn}" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Border x:Name="SepBanner" Height="1" Background="{DynamicResource DividerBrush}" Visibility="Collapsed"/>

            <!-- Hero (selected period). The kicker shares its row with the period segment;
                 the segment is ALWAYS visible - even while every data section below is
                 still loading, changing it is the one action that always works. The cost
                 number doubles as the empty/failed title slot, like 1.0.2 - only the
                 strings became period-aware. -->
            <StackPanel Margin="{StaticResource SectionPad}" x:Name="HeroPanel">
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="TODAY" x:Name="TodayHeader" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" CornerRadius="4" Padding="1" Background="{DynamicResource SegBg}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="Period0Btn" Click="Period_Click" Tag="today" Content="Today" Style="{StaticResource SegBtn}"/>
                            <Button x:Name="Period1Btn" Click="Period_Click" Tag="week" Content="Week" Style="{StaticResource SegBtn}"/>
                            <Button x:Name="Period2Btn" Click="Period_Click" Tag="month" Content="Month" Style="{StaticResource SegBtn}"/>
                            <Button x:Name="Period3Btn" Click="Period_Click" Tag="year" Content="Year" Style="{StaticResource SegBtn}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- Loading skeleton: gray bars in the cost/sub-line slots, never a
                     full-screen spinner (contract loading case: has_full_screen_spinner false). -->
                <StackPanel x:Name="HeroSkeleton" Visibility="Collapsed">
                    <Border Height="26" Width="120" CornerRadius="4" Background="{DynamicResource BarTrack}" Margin="0,4,0,0"/>
                    <Border Height="12" Width="220" CornerRadius="3" Background="{DynamicResource BarTrack}" Margin="0,8,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TodayCost" Text="…" FontSize="{StaticResource FontHero}" FontWeight="SemiBold" Style="{StaticResource BodyText}"/>
                <!-- TextWrapping: the empty-state sub-line is long enough to ellipsize at
                     flyout width, which reads as broken. Wrap it instead. -->
                <TextBlock x:Name="TodaySub" Text="" FontSize="{StaticResource FontSecondary}" TextWrapping="Wrap" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}"/>
                <!-- Cost-only worded comparison (fullDeltaRow off). -->
                <TextBlock x:Name="TodayCmp" Text="" FontSize="{StaticResource FontSecondary}" Foreground="#0F7B0F" Style="{StaticResource BodyText}" Visibility="Collapsed"/>
                <!-- Full delta row (fullDeltaRow on): colored runs built in code-behind. -->
                <TextBlock x:Name="DeltaRow" TextWrapping="Wrap" FontSize="{StaticResource FontSecondary}" Style="{StaticResource BodyText}" Visibility="Collapsed"/>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource DividerBrush}"/>

            <!-- Top ranks: three tools (with marks) + three models (text-only). -->
            <StackPanel x:Name="RanksPanel" Margin="{StaticResource SectionPad}" Visibility="Collapsed">
                <TextBlock x:Name="ToolsKicker" Text="" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}"/>
                <ItemsControl x:Name="ToolsStrip" Margin="0,4,0,0" ItemTemplate="{StaticResource RankTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="ModelsKicker" Text="" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
                <ItemsControl x:Name="ModelsStrip" Margin="0,4,0,0" ItemTemplate="{StaticResource RankTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <Border x:Name="SepRanks" Height="1" Background="{DynamicResource DividerBrush}" Visibility="Collapsed"/>

            <!-- Activity glance: one face at a time, built in code-behind (bars/columns/grid). -->
            <StackPanel x:Name="GlancePanel" Margin="{StaticResource SectionPad}" Visibility="Collapsed">
                <TextBlock x:Name="GlanceKicker" Text="" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}"/>
                <ContentControl x:Name="GlanceHost" Margin="0,6,0,0" Focusable="False"/>
                <TextBlock x:Name="GlanceCaption" Text="" FontSize="{StaticResource FontCaption}" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
            </StackPanel>
            <Border x:Name="SepGlance" Height="1" Background="{DynamicResource DividerBrush}" Visibility="Collapsed"/>

            <!-- Per-server rows: only with more than one enabled server; this cycle only. -->
            <StackPanel x:Name="PerServerPanel" Margin="{StaticResource SectionPad}" Visibility="Collapsed">
                <TextBlock x:Name="PerServerKicker" Text="" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}"/>
                <ItemsControl x:Name="PerServerRowsCtl" Margin="0,4,0,0"/>
                <TextBlock x:Name="PerServerFootnote" Text="" FontSize="{StaticResource FontMicro}" Style="{StaticResource BodyText}" Foreground="{DynamicResource FaintBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border x:Name="SepPerServer" Height="1" Background="{DynamicResource DividerBrush}" Visibility="Collapsed"/>

            <!-- Quota section -->
            <StackPanel Margin="{StaticResource SectionPad}" x:Name="QuotaPanel">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="QuotaHeader" Text="SUBSCRIPTION" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" Style="{StaticResource BodyText}" Foreground="{DynamicResource MutedBrush}"/>
                    <Border Grid.Column="1" CornerRadius="4" Padding="1" Background="{DynamicResource SegBg}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LowBtn" Click="Low_Click" Content="Low" Style="{StaticResource SegBtn}"/>
                            <Button x:Name="AllBtn" Click="All_Click" Content="All" Style="{StaticResource SegBtn}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- Items are a mix of QuotaRowVM (rendered via QuotaRowTemplate) and plain
                     UIElements (warnings/empty-state/retry) added directly in code-behind -
                     WPF hosts a UIElement item as-is and only applies the ItemTemplate to
                     non-visual items, so both share this one container. -->
                <ItemsControl x:Name="QuotaRows" ItemTemplate="{StaticResource QuotaRowTemplate}"/>
                <!-- Quota loading skeleton (loading case): bars, not a spinner. -->
                <StackPanel x:Name="QuotaSkeleton" Visibility="Collapsed" Margin="0,2,0,0">
                    <Border Height="12" CornerRadius="3" Background="{DynamicResource BarTrack}" Margin="0,0,0,8"/>
                    <Border Height="12" Width="240" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource BarTrack}"/>
                </StackPanel>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource DividerBrush}"/>

            <!-- Action row -->
            <StackPanel Margin="{StaticResource BandPad}" Orientation="Horizontal">
                <Button Click="OpenDashboard_Click" x:Name="OpenDashboardBtn" Content="Open Dashboard" Padding="14,5,14,6" Style="{StaticResource PrimaryBtn}"/>
            </StackPanel>

            <!-- Footer band -->
            <Border Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource FooterBorder}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="{StaticResource FooterPad}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="FreshnessText" FontSize="{StaticResource FontCaption}" Style="{StaticResource BodyText}" Foreground="{DynamicResource FaintBrush}"/>
                    <TextBlock Grid.Column="1" x:Name="TrayHint" Text="Right-click tray icon for more" FontSize="{StaticResource FontCaption}" Style="{StaticResource BodyText}" Foreground="{DynamicResource FaintBrush}"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
