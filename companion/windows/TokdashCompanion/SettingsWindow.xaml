<Window
    x:Class="TokdashCompanion.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tokdash Settings"
    Width="440"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Background="#F2F4F7">
    <StackPanel Margin="20">
        <StackPanel.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            </Style>
        </StackPanel.Resources>

        <TextBlock Text="Server" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox x:Name="BaseUrlBox" Margin="0,0,0,4"/>
        <TextBlock Text="Default: http://127.0.0.1:55423. Tailscale HTTPS URLs are supported."
                   FontSize="11" Foreground="#5F5F5F" Margin="0,0,0,16"/>

        <TextBlock Text="Startup" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <CheckBox x:Name="LaunchBox" Content="Launch at login" Margin="0,0,0,16"/>

        <TextBlock Text="Notifications" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <CheckBox x:Name="NotifyBox" Content="Low-quota notifications" Margin="0,0,0,4"/>
        <TextBlock Text="Notifies when a subscription window crosses its threshold. Opt-in."
                   FontSize="11" Foreground="#5F5F5F" Margin="0,0,0,16"/>

        <TextBlock Text="Quota alert thresholds (% remaining)" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <StackPanel Margin="0,0,0,20">
            <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="FiveHourLabel" DockPanel.Dock="Left" Text="5-hour: 20%" VerticalAlignment="Center" Width="110"/>
                <Slider x:Name="FiveHourSlider" Minimum="5" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="20" ValueChanged="Slider_Changed"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="WeeklyLabel" DockPanel.Dock="Left" Text="Weekly: 10%" VerticalAlignment="Center" Width="110"/>
                <Slider x:Name="WeeklySlider" Minimum="5" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="10" ValueChanged="Slider_Changed"/>
            </DockPanel>
            <DockPanel>
                <TextBlock x:Name="OtherLabel" DockPanel.Dock="Left" Text="Default: 15%" VerticalAlignment="Center" Width="110"/>
                <Slider x:Name="OtherSlider" Minimum="5" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="15" ValueChanged="Slider_Changed"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" Padding="16,5"/>
            <Button Content="Save" Click="Save_Click" Padding="16,5" FontWeight="SemiBold"/>
        </StackPanel>
    </StackPanel>
</Window>
